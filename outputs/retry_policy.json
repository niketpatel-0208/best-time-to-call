  "callback_time_layer": {
    "description": "Ordered rules that turn the last call's callback-time extraction (callback-time-extraction) plus the seller's model bands into a next_call_at. Apply in order; the first rule that fires wins.",
    "precedence": [
      {
        "order": 1,
        "source": "do_not_call",
        "when": "extraction.do_not_call is true, or the call outcome is Do Not Call",
        "next_call_at": null,
        "rule": "No next call."
      },
      {
        "order": 2,
        "source": "meeting_fixed",
        "when": "the call outcome is Meeting Fixed",
        "next_call_at": null,
        "rule": "No bot call."
      },
      {
        "order": 3,
        "source": "seller_stated",
        "when": "cue_strength is explicit, confidence >= 0.7, and callback_at is set",
        "next_call_at": "callback_at (= the stated time - 5 min), clamped to 09:00-20:55 IST",
        "rule": "Seller-stated times win."
      },
      {
        "order": 4,
        "source": "seller_hint",
        "when": "an implicit cue: a window, or an earliest_date, or both",
        "next_call_at": "the first of rec_band / backup_band_1 / backup_band_2 that overlaps the window on the hinted day (band start); earliest_date only -> the first rec_band slot on or after that date; both -> the window on earliest_date. If no band overlaps, use window_start.",
        "rule": "Hints narrow the window."
      },
      {
        "order": 5,
